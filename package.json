{
  "name": "bmad-board",
  "version": "0.1.0",
  "description": "Jira-like kanban board for BMAD methodology projects. Visualize epics, stories, and sprint progress from your _bmad-output/ files.",
  "keywords": ["bmad", "kanban", "board", "project-management", "agile", "cli"],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "type": "module",
  "bin": {
    "bmad-board": "./dist/cli.js"
  },
  "main": "./dist/server/index.js",
  "files": [
    "dist",
    "ui-dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/cli.ts -- --path ../budget/budget-app/_bmad-output",
    "dev:ui": "cd ui && vite dev",
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "cd ui && npx vite build",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src ui/src --ext .ts,.tsx"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "fastify": "^5.2.1",
    "@fastify/static": "^8.1.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/websocket": "^11.0.1",
    "gray-matter": "^4.0.3",
    "yaml": "^2.7.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
